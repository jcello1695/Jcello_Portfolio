<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="QSightClient.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:QSightClient"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="QSightClient">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <NavigationView
            x:Name="RootNav"
            PaneTitle="Q-Sight Agent"
            IsSettingsVisible="False"
            PaneDisplayMode="Top"
            IsBackButtonVisible="Visible" 
            IsBackEnabled="False" 
            BackRequested="RootNav_BackRequested">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dashboard" Icon="Home" Tag="status"/>
                <NavigationViewItem Content="Scan" Icon="Find" Tag="scan"/>
                <NavigationViewItem Content="Logs" Icon="Document" Tag="logs"/>
                <NavigationViewItem Content="About" Icon="Help" Tag="about"/>
            </NavigationView.MenuItems>

            <ScrollViewer x:Name="RootScrollViewer"
                          VerticalScrollBarVisibility="Auto" 
                          HorizontalScrollBarVisibility="Disabled">

                <Frame x:Name="ContentFrame" Padding="0"/>

            </ScrollViewer>

        </NavigationView>
    </Grid>
</Window>
